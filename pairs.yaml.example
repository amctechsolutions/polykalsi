# pairs.yaml — operator-managed. Copy to pairs.yaml and fill in real IDs.
# arb-obs will fail closed at startup if pairs.yaml is missing, empty, or
# unparseable. No ticker or token ID is ever sourced from model memory —
# look each one up directly on kalshi.com / polymarket.com before adding it.
#
# pm_fee_rate is the category taker-fee rate for THIS market, per
# docs.polymarket.com/trading/fees: fee = C * feeRate * p * (1-p), rate by
# category — Crypto 0.07, Sports/Economics/Culture/Weather/Other 0.05,
# Finance/Politics/Mentions/Tech 0.04, Geopolitics 0. No exponent
# parameter exists; do not add one back.
#
# MUST be set by looking at the category on the market's own page on
# polymarket.com, NOT read from any API field. Confirmed live 2026-08-30
# (Task 1.5, round 3): a Crypto market and a Politics market both returned
# identical takerBaseFee/makerBaseFee values via the Gamma API — those
# fields do not differentiate by category and cannot be trusted as this
# rate's source. The instrument fetches that same untrustworthy metadata
# once at startup anyway and records it in every ledger row as
# pm_fee_metadata_raw, purely so this rate (pm_fee_rate_operator in the
# ledger) can be audited against it later if the API's behavior changes.
pairs:
  - pair_id: "example-pair-1"
    enabled: false
    kalshi_ticker: "REPLACE_WITH_REAL_KALSHI_TICKER"
    polymarket_condition_id: "REPLACE_WITH_REAL_CONDITION_ID"
    polymarket_yes_token_id: "REPLACE_WITH_REAL_YES_TOKEN_ID"
    polymarket_no_token_id: "REPLACE_WITH_REAL_NO_TOKEN_ID"
    pm_fee_rate: null
